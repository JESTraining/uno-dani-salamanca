@OrderService.API_HostAddress = http://localhost:5290
@orderId = 00000000-0000-0000-0000-000000000000

### Create order
# Responds 503 while Inventory Service does not exist (Phase 2): validates
# stock before creating the order, by design.
POST {{OrderService.API_HostAddress}}/api/orders
Content-Type: application/json
Idempotency-Key: 11111111-1111-1111-1111-111111111111

{
  "customerId": "a1b2c3d4-0000-0000-0000-000000000001",
  "customerName": "Jane Doe",
  "customerEmail": "jane.doe@example.com",
  "items": [
    {
      "productId": "c3d4e5f6-0000-0000-0000-000000000003",
      "productName": "Widget",
      "quantity": 2,
      "unitPrice": 9.99
    }
  ]
}

### Get order by id
GET {{OrderService.API_HostAddress}}/api/orders/{{orderId}}
Accept: application/json

### List orders (paginated, with optional filters)
GET {{OrderService.API_HostAddress}}/api/orders?page=1&pageSize=20
Accept: application/json

### Update order status
# Valid values: Pending, PaymentProcessing, PaymentFailed, InventoryProcessing,
# InventoryFailed, Completed, Cancelled, Shipped, Delivered.
PUT {{OrderService.API_HostAddress}}/api/orders/{{orderId}}/status
Content-Type: application/json

{
  "status": "PaymentProcessing"
}

### Cancel order
# Only allowed while the order is in Pending or PaymentProcessing.
DELETE {{OrderService.API_HostAddress}}/api/orders/{{orderId}}
