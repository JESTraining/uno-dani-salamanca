{
  "ConnectionStrings": {
    "OrderDb": "Host=postgres;Port=5432;Database=orderdb;Username=order_service;Password=order_service_dev_pwd"
  },
  "RabbitMq": {
    "Host": "rabbitmq"
  },
  "Services": {
    "InventoryService": {
      "BaseUrl": "http://inventory-service:8080"
    }
  },
  "Otlp": {
    "Endpoint": "http://jaeger:4317"
  },
  "Serilog": {
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/order-service-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://seq:5341" }
      }
    ]
  }
}
