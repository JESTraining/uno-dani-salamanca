{
  "ConnectionStrings": {
    "InventoryDb": "Host=postgres;Port=5432;Database=inventorydb;Username=inventory_service;Password=inventory_service_dev_pwd"
  },
  "RabbitMq": {
    "Host": "rabbitmq"
  },
  "Otlp": {
    "Endpoint": "http://jaeger:4317"
  },
  "Serilog": {
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/inventory-service-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://seq:5341" }
      }
    ]
  }
}
