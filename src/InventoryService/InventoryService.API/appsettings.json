{
  "ConnectionStrings": {
    "InventoryDb": "Host=localhost;Port=5432;Database=inventorydb;Username=inventory_service;Password=inventory_service_dev_pwd"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Username": "guest",
    "Password": "guest"
  },
  "Jwt": {
    "SigningKey": "dev-only-signing-key-do-not-use-in-production-replace-via-Jwt__SigningKey-env-var-1234567890",
    "Issuer": "ApiGateway",
    "Audience": "OrderProcessingSystem"
  },
  "Otlp": {
    "Endpoint": "http://localhost:4317"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/inventory-service-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341" }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "ServiceName": "InventoryService"
    }
  },
  "AllowedHosts": "*"
}
