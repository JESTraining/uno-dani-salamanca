{
  "ReverseProxy": {
    "Clusters": {
      "order-service-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://order-service:8080/" }
        }
      },
      "payment-service-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://payment-service:8080/" }
        }
      },
      "inventory-service-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://inventory-service:8080/" }
        }
      }
    }
  },
  "Otlp": {
    "Endpoint": "http://jaeger:4317"
  },
  "Serilog": {
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/api-gateway-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://seq:5341" }
      }
    ]
  }
}
