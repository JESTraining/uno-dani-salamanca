{
  "Jwt": {
    "SigningKey": "dev-only-signing-key-do-not-use-in-production-replace-via-Jwt__SigningKey-env-var-1234567890",
    "Issuer": "ApiGateway",
    "Audience": "OrderProcessingSystem",
    "ExpirationMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Otlp": {
    "Endpoint": "http://localhost:4317"
  },
  "ReverseProxy": {
    "Routes": {
      "orders-collection-route": {
        "ClusterId": "order-service-cluster",
        "Match": { "Path": "/api/v1/orders" }
      },
      "orders-route": {
        "ClusterId": "order-service-cluster",
        "Match": { "Path": "/api/v1/orders/{**catch-all}" }
      },
      "orders-hub-route": {
        "ClusterId": "order-service-cluster",
        "Match": { "Path": "/hubs/orders/{**catch-all}" }
      },
      "payments-collection-route": {
        "ClusterId": "payment-service-cluster",
        "Match": { "Path": "/api/v1/payments" }
      },
      "payments-route": {
        "ClusterId": "payment-service-cluster",
        "Match": { "Path": "/api/v1/payments/{**catch-all}" }
      },
      "products-collection-route": {
        "ClusterId": "inventory-service-cluster",
        "Match": { "Path": "/api/v1/products" }
      },
      "products-route": {
        "ClusterId": "inventory-service-cluster",
        "Match": { "Path": "/api/v1/products/{**catch-all}" }
      }
    },
    "Clusters": {
      "order-service-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5290/" }
        }
      },
      "payment-service-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5033/" }
        }
      },
      "inventory-service-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5225/" }
        }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/api-gateway-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341" }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "ServiceName": "ApiGateway"
    }
  },
  "AllowedHosts": "*"
}
